# Database (Supabase Postgres or any PostgreSQL)
# Copy this file to .env.local and fill in real values.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Optional Supabase client (app uses Prisma/server auth today)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL (Stripe redirects, invite links, Plaid Link bridge)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Expo Go client → Next.js API (also set in mobile/.env)
# Use your LAN IP so a physical phone can reach the API, e.g. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Centsy AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000

# Optional vision provider (still scaffolded; Snap persists demo extracts today)
OPENAI_API_KEY=

# Stripe — prefer restricted key rk_ over sk_
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Optional: protect POST /api/push/weekly-review cron
CRON_SECRET=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
