// Centsy — live dual-mode finance + Centsy AI schema
// Apply: npx prisma migrate dev --name init_live

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FinanceMode {
  PERSONAL
  BUSINESS
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionCategory {
  FOOD
  SOFTWARE
  TRAVEL
  TRANSPORT
  HOUSING
  UTILITIES
  HEALTHCARE
  SHOPPING
  ENTERTAINMENT
  OFFICE
  MARKETING
  INCOME
  OTHER
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  fullName           String
  passwordHash       String
  avatarUrl          String?
  defaultMode        FinanceMode @default(PERSONAL)
  /// Free-text profile notes Centsy AI should remember (family, goals, etc.)
  aiProfile          String?
  /// Business workspace display name (DBA / legal trade name)
  businessName       String?
  /// Business contact email (separate from personal login email)
  businessEmail      String?
  /// Employer Identification Number (EIN) for business exports / tax records
  businessEin        String?
  /// Stripe Connect account id when business KPIs are linked
  stripeAccountId    String?
  /// Stripe Customer id for Centsy Pro billing
  stripeCustomerId   String?
  /// Active Centsy Pro subscription id
  stripeSubscriptionId String?
  /// FREE | PRO
  plan               String      @default("FREE")
  /// Expo push token for weekly review / alerts
  expoPushToken      String?
  /// Prefer cloud-backed receipt storage (IRS-friendly digital records)
  receiptCloudBackup Boolean     @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  sessions           Session[]
  transactions       Transaction[]
  mileageLogs        MileageLog[]
  bankAccounts       BankAccount[]
  receipts           Receipt[]
  chatThreads        ChatThread[]
  aiMemories         AiMemory[]
  accountantInvites  AccountantInvite[]

  @@index([email])
}

model AccountantInvite {
  id          String   @id @default(cuid())
  ownerUserId String
  email       String
  token       String   @unique
  status      String   @default("PENDING") // PENDING | ACTIVE | REVOKED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  acceptedAt  DateTime?
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  mode              FinanceMode
  merchant          String
  amount            Decimal             @db.Decimal(12, 2)
  date              DateTime
  category          TransactionCategory
  type              TransactionType
  notes             String?
  receiptUrl        String?
  lineItems         Json?
  reconciled        Boolean             @default(false)
  bankTransactionId String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt           Receipt?
  bankTransaction   BankTransaction?    @relation(fields: [bankTransactionId], references: [id])

  @@index([userId, mode])
  @@index([userId, mode, date])
  @@index([userId, category])
  @@index([merchant])
}

model Receipt {
  id            String       @id @default(cuid())
  userId        String
  mode          FinanceMode
  transactionId String?      @unique
  imageUrl      String
  rawExtract    Json?
  confidence    Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId, mode])
}

model MileageLog {
  id           String      @id @default(cuid())
  userId       String
  mode         FinanceMode
  date         DateTime
  miles        Float
  purpose      String
  fromLocation String?
  toLocation   String?
  gasCost      Decimal?    @db.Decimal(12, 2)
  ratePerMile  Decimal     @db.Decimal(6, 4)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode])
  @@index([userId, mode, date])
}

model BankAccount {
  id              String            @id @default(cuid())
  userId          String
  /// Workspace realm — Personal banks never appear in Business and vice versa
  mode            FinanceMode       @default(PERSONAL)
  institutionName String
  accountName     String
  mask            String
  type            BankAccountType
  balance         Decimal           @db.Decimal(14, 2) @default(0)
  plaidItemId     String?
  plaidAccessEnc  String?
  connectedAt     DateTime          @default(now())
  lastSyncedAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([userId])
  @@index([userId, mode])
}

model BankTransaction {
  id            String      @id @default(cuid())
  bankAccountId String
  mode          FinanceMode
  merchant      String
  amount        Decimal     @db.Decimal(12, 2)
  date          DateTime
  pending       Boolean     @default(false)
  /// Soft-dismiss from Home inbox without posting to the ledger
  ignored       Boolean     @default(false)
  plaidTxnId    String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedTxn    Transaction?

  @@index([bankAccountId, mode])
  @@index([mode, date])
  @@index([bankAccountId, ignored])
}

/// Centsy AI conversation thread (one active companion thread per user by default)
model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("Centsy AI")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      ChatRole
  content   String
  /// Optional retrieval snapshot used for this reply (debugging / eval)
  contextJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Durable facts Centsy AI learns about the user over time
model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}
